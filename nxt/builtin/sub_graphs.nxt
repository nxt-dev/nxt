{
    "version": "1.17",
    "alias": "sub_graphs",
    "color": "#6e33bb",
    "mute": false,
    "solo": false,
    "meta_data": {
        "positions": {
            "/_maya_standalone_graph": [
                0.0,
                40.0
            ],
            "/_blender_background_graph": [
                0.0,
                120.0
            ],
            "/_unreal_headless_graph": [
                0.0,
                200.0
            ]
        }
    },
    "nodes": {
        "/": {
            "code": [
                "import platform",
                "import shutil",
                "import os",
                "import subprocess",
                "import glob",
                "import json"
            ]
        },
        "/_maya_standalone_graph": {
            "instance": "",
            "comment": "This node is meant to run an nxt graph in Maya standalone. ",
            "attrs": {
                "_MAYA_LOCATION": {
                    "comment": "Location for you maya",
                    "type": "raw",
                    "value": "${file::C:/Program Files/Autodesk/Maya${_maya_version}}"
                },
                "_graph_path": {
                    "comment": "The path to your nxt graph you want to run with Maya standalone",
                    "type": "str",
                    "value": "\"\""
                },
                "_maya_run_command": {
                    "comment": "The path to the cli python file. This usually is something setup to run from a shell.",
                    "type": "raw",
                    "value": "os.path.join(constants.EDITOR_DIR, \"integration/maya/run_maya_graph.py\")"
                },
                "_maya_version": {
                    "comment": "Which version of Maya you're using this for. This helps construct MAYA_LOCATION path",
                    "type": "int",
                    "value": "2023"
                },
                "_mayapy_exe": {
                    "comment": "Path to you mayapy.exe",
                    "type": "list",
                    "value": "[\"${_MAYA_LOCATION}/bin/mayapy.exe\"]"
                },
                "_parameters": {
                    "comment": "parameters are arguments you can pass to the graph. eg(\"{'/.name1': 'test', '/.name2': 'test_2''}\")",
                    "type": "dict",
                    "value": "{}"
                },
                "_start_node": {
                    "comment": "The node you wish to run strat running from in the nxt graph",
                    "type": "NoneType",
                    "value": "None"
                },
                "_use_shell": {
                    "type": "bool",
                    "value": "False"
                },
                "_wait": {
                    "comment": "Whether or not to wait for the sub-process to finish before continuing",
                    "type": "bool",
                    "value": "False"
                }
            },
            "code": [
                "import nxt_editor.constants as constants",
                "# declare the parameters variable based on the attribute",
                "parameters = ${_parameters}",
                "# if the parameters are a dict we will dump it into json",
                "# otherwise we will pass it directly to the subprocess",
                "if isinstance(parameters, dict):",
                "    parameters = json.dumps(parameters)",
                "",
                "# run the subprocess",
                "command = ${_mayapy_exe} + [${_maya_run_command}] + [\"-g\", ${_graph_path}, \"-p\", parameters]",
                "# only pass a start node when one is set, so the graph's own start",
                "# point is used otherwise",
                "start_node = ${_start_node}",
                "if start_node:",
                "    command += [\"-s\", start_node]",
                "process = subprocess.Popen(command, shell=${_use_shell})",
                "",
                "# if _wait is set to True, this node will not continue the build  ",
                "# until the subprocess is complete",
                "if ${_wait}:",
                "    process.wait()"
            ]
        },
        "/_blender_background_graph": {
            "comment": "Runs an nxt graph in Blender in the background, without its UI. See integration/blender/run_blender_graph.py.",
            "code": [
                "import nxt_editor.constants as constants",
                "# The parameters go on the command line as JSON.",
                "parameters = ${_parameters}",
                "if isinstance(parameters, dict):",
                "    parameters = json.dumps(parameters)",
                "",
                "command = ${_blender_exe} + ['--background']",
                "# A .blend to open first, if any.",
                "blend_file = ${_blend_file}",
                "if blend_file:",
                "    command += [blend_file]",
                "# Blender leaves everything after -- to the script.",
                "command += ['--python', ${_blender_run_command}, '--',",
                "            '-g', ${_graph_path}, '-p', parameters]",
                "start_node = ${_start_node}",
                "if start_node:",
                "    command += ['-s', start_node]",
                "process = subprocess.Popen(command, shell=${_use_shell})",
                "",
                "# if _wait is set to True, this node will not continue the build",
                "# until Blender is done",
                "if ${_wait}:",
                "    process.wait()"
            ],
            "attrs": {
                "_BLENDER_LOCATION": {
                    "comment": "Where Blender is installed",
                    "type": "raw",
                    "value": "${file::C:/Program Files/Blender Foundation/Blender ${_blender_version}}"
                },
                "_blend_file": {
                    "comment": "A .blend file to open before the graph runs, or None for a new scene.",
                    "type": "NoneType",
                    "value": "None"
                },
                "_blender_exe": {
                    "comment": "The Blender executable",
                    "type": "list",
                    "value": "[\"${_BLENDER_LOCATION}/blender.exe\"]"
                },
                "_blender_run_command": {
                    "comment": "The script Blender runs the graph with",
                    "type": "raw",
                    "value": "os.path.join(constants.EDITOR_DIR, \"integration/blender/run_blender_graph.py\")"
                },
                "_blender_version": {
                    "comment": "Which version of Blender to use. This helps construct _BLENDER_LOCATION",
                    "type": "float",
                    "value": "5.1"
                },
                "_graph_path": {
                    "comment": "The path to the nxt graph you want to run.",
                    "type": "str",
                    "value": "\"\""
                },
                "_parameters": {
                    "comment": "Values to set before the graph runs, keyed by attribute path, eg {'/.name': 'test'}",
                    "type": "dict",
                    "value": "{}"
                },
                "_start_node": {
                    "comment": "The node to start from, as a string such as '/build'. None runs from the graph's own start point.",
                    "type": "NoneType",
                    "value": "None"
                },
                "_use_shell": {
                    "type": "bool",
                    "value": "False"
                },
                "_wait": {
                    "comment": "Whether to wait for the run to finish before the build continues",
                    "type": "bool",
                    "value": "False"
                }
            }
        },
        "/_unreal_headless_graph": {
            "comment": "Runs an nxt graph in Unreal without its UI, in a project that has the nxt plugin enabled. See the plugin's Content/Python/run_unreal_graph.py.",
            "code": [
                "# Unreal splits -script at every space, so the arguments go to the",
                "# runner in NXT_RUN_GRAPH_ARGS, and any path works.",
                "parameters = ${_parameters}",
                "if isinstance(parameters, dict):",
                "    parameters = json.dumps(parameters)",
                "args = ['-g', ${_graph_path}, '-p', parameters]",
                "start_node = ${_start_node}",
                "if start_node:",
                "    args += ['-s', start_node]",
                "env = dict(os.environ, NXT_RUN_GRAPH_ARGS=json.dumps(args))",
                "",
                "command = ${_unreal_cmd_exe} + [${_project}, '-run=pythonscript',",
                "                                '-script=run_unreal_graph.py']",
                "command += ${_unreal_args}",
                "process = subprocess.Popen(command, shell=${_use_shell}, env=env)",
                "",
                "# if _wait is set to True, this node will not continue the build",
                "# until Unreal is done",
                "if ${_wait}:",
                "    process.wait()"
            ],
            "attrs": {
                "_UNREAL_LOCATION": {
                    "comment": "Where the engine is installed",
                    "type": "raw",
                    "value": "${file::C:/Program Files/Epic Games/UE_${_unreal_version}}"
                },
                "_project": {
                    "comment": "The .uproject to run in. It must have the nxt plugin and the Python Editor Script Plugin enabled.",
                    "type": "str",
                    "value": "\"\""
                },
                "_unreal_args": {
                    "comment": "More arguments for Unreal",
                    "type": "list",
                    "value": "[\"-unattended\", \"-nosplash\", \"-nullrhi\"]"
                },
                "_unreal_cmd_exe": {
                    "comment": "The engine's command line editor",
                    "type": "list",
                    "value": "[\"${_UNREAL_LOCATION}/Engine/Binaries/Win64/UnrealEditor-Cmd.exe\"]"
                },
                "_unreal_version": {
                    "comment": "Which version of the engine to use. This helps construct _UNREAL_LOCATION",
                    "type": "float",
                    "value": "5.4"
                },
                "_graph_path": {
                    "comment": "The path to the nxt graph you want to run.",
                    "type": "str",
                    "value": "\"\""
                },
                "_parameters": {
                    "comment": "Values to set before the graph runs, keyed by attribute path, eg {'/.name': 'test'}",
                    "type": "dict",
                    "value": "{}"
                },
                "_start_node": {
                    "comment": "The node to start from, as a string such as '/build'. None runs from the graph's own start point.",
                    "type": "NoneType",
                    "value": "None"
                },
                "_use_shell": {
                    "type": "bool",
                    "value": "False"
                },
                "_wait": {
                    "comment": "Whether to wait for the run to finish before the build continues",
                    "type": "bool",
                    "value": "False"
                }
            }
        },
        "/_sub_graph": {
            "attrs": {
                "_cache_file": {},
                "_graph_path": {
                    "type": "NoneType"
                },
                "_parameters": {
                    "type": "dict",
                    "value": "{}"
                },
                "_start": {
                    "type": "NoneType",
                    "value": "None"
                }
            },
            "code": [
                "import os",
                "import sys",
                "from nxt import nxt_node, nxt_path",
                "from nxt.stage import Stage",
                "",
                "if self._graph_path and os.path.isfile(self._graph_path):",
                "    sub_stage = Stage.load_from_filepath(self._graph_path)",
                "    ",
                "    # Assemble parameters dictionary",
                "    params = ${_parameters}",
                "    for attr_name, attr_val in vars(self).items():",
                "        if attr_name in nxt_node.INTERNAL_ATTRS.PROTECTED:",
                "            continue",
                "        if attr_name in ('_graph_path', '_start'):",
                "            continue",
                "        attr_path = nxt_path.make_attr_path(nxt_path.WORLD, attr_name)",
                "        params[attr_path] = attr_val",
                "    try:",
                "        result_rt_layer = sub_stage.execute(parameters=params, start=self._start)",
                "    except ExitGraph as exit_graph:",
                "        result_rt_layer = exit_graph.runtime_layer",
                "    if self._cache_file:",
                "        result_rt_layer.cache_layer.save('${_cache_file}')",
                "    # Bring attributes back from world node onto this node",
                "    world_frame_node = result_rt_layer.cache_layer.lookup(nxt_path.WORLD)",
                "    for attr_name, attr_val in vars(world_frame_node).items():",
                "        if attr_name in nxt_node.INTERNAL_ATTRS.PROTECTED:",
                "            continue",
                "        setattr(self, attr_name, attr_val)"
            ]
        }
    }
}