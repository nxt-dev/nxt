                "shared": {
                    "type": "raw",
                    "value": "right"
                }
            },
            "code": [
                "print(\"We've got it ${root_attr}\")",
                "# The next node shares a local attribute with this one.",
                "# That attribute is named \"shared\". The raw pattern for",
                "# root_attr here substitues shared. This must be resolved in",
                "# the context of this node, not the node it is subsituted into",
                "# where it would resolve to something different due to",
                "# sharing the local attribute \"shared\"."
            ]
